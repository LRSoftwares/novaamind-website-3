# All optional. With none set, form submissions are accepted and written to the
# server log only — fine for local dev, NOT for production.

# Supabase: store every lead in a `leads` table (see docs/LEADS.md for the SQL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: email the founder on every submission
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# GitHub login for the content manager at /admin/ (see docs/CMS.md)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
