---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found | Novaamind" description="The page you were looking for could not be found." noindex>
  <PageHero eyebrow="404" title="We could not find this page." description="It may have moved when we rebuilt the site. These are good places to continue:">
    <div class="btn-row">
      <a class="btn btn--light" href="/">Home <Icon name="arrow" /></a>
      <a class="btn btn--outline-light" href="/solutions/">Solutions</a>
      <a class="btn btn--outline-light" href="/contact/">Contact</a>
    </div>
  </PageHero>
</Base>
