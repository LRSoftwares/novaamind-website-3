---
import Icon from './Icon.astro';
import { site } from '../lib/site';
import { photos } from '../lib/images';
interface Props { title?: string; text?: string }
const {
  title = 'Start with a conversation.',
  text = 'In an Executive AI Discovery Session we look at your priorities and give you a candid view of where AI can help first and where it should wait.',
} = Astro.props;
---
<section class="section section--tight">
  <div class="container">
    <div class="cta-banner cta-banner--photo" data-reveal>
      <div class="cta-banner__bg" aria-hidden="true"><img src={photos.cta.src} alt="" loading="lazy" decoding="async" /></div>
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--light" href={site.primaryCta.href}>{site.primaryCta.label} <Icon name="arrow" /></a>
      </div>
    </div>
  </div>
</section>
